# ---------------------------------------------------------------------------
# Study Buddy — environment file (copy to .env and fill in).
#
# NOTHING SECRET GOES INTO GIT. This file is .gitignore'd, and the real AI
# keys do not even live here — they live in the Supabase table `app_secrets`
# (RLS on, no client policies) and are pulled in by the server at startup.
# ---------------------------------------------------------------------------

# --- Supabase (email/Google login + cloud storage for messages & puskice) ---
# Dashboard -> Project Settings -> API. The publishable key is client-safe.
# NEVER put the secret key in a VITE_ variable or in this repo.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# --- Supabase service role key (SERVER SIDE ONLY, gitignored) ---
# Dashboard -> Project Settings -> API -> `service_role` (Reveal).
# Used by server.ts to read the AI secrets from the `app_secrets` table.
# Never commit it and never paste it in a chat.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Sign-In (OAuth Client ID, public by design) ---
# Google Cloud Console -> Credentials -> Web client (OAuth 2.0 Client ID).
# Add http://localhost:3000 to "Authorized JavaScript origins".
VITE_GOOGLE_CLIENT_ID=

# --- Optional local fallback for the AI secrets -----------------------------
# These names are normally read from Supabase `app_secrets`:
#   GEMINI_API_KEY, GEMINI_MODEL, WOLFRAM_APPID, ELEVENLABS_API_KEY
# If you set them here as well, they are used only when Supabase is
# unreachable (e.g. offline). Keeping them ONLY in Supabase is preferred.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# WOLFRAM_APPID=
# ELEVENLABS_API_KEY=
