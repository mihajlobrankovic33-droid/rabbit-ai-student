# --- AI (chat, notes, classroom) ---
# Google AI Studio key -> https://aistudio.google.com/apikey
# REQUIRED for the cloud chat agent (server reads GEMINI_API_KEY or VITE_GEMINI_API_KEY)
GEMINI_API_KEY=

# Optional: override the single model used by every AI endpoint.
# Default (and recommended): gemini-flash-latest
# GEMINI_MODEL=gemini-flash-latest

# --- Wolfram Alpha (exact formulas, calculations and final answers) ---
# Free app id -> https://developer.wolframalpha.com
# Optional: without it the chat works normally, just without the verified
# "Wolfram Alpha" answer block for math/computation questions.
WOLFRAM_APPID=

# --- Voices (optional) ---
# ElevenLabs API secret key (must start with 'sk_', not the Key ID)
ELEVENLABS_API_KEY=
